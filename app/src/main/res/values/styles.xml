    <style name="Theme.Tidy.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#006C60</item>
        <item name="android:windowBackground">#EDF3F5</item>
